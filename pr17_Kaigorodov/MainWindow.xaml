<Window x:Class="pr17_Kaigorodov.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr17_Kaigorodov"
        mc:Ignorable="d"
        Title="MainWindow" Height="550" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Меню -->
        <Menu Grid.Row="0" Margin="0,0,0,10">
            <MenuItem Header="Задания">
                <MenuItem Header="Задание 1 - Поиск слова в тексте" Click="Task1_Click"/>
                <MenuItem Header="Задание 2 - Обработка массива с '/'" Click="Task2_Click"/>
                <MenuItem Header="Задание 3 - Частота чисел" Click="Task3_Click"/>
                <MenuItem Header="Задание 4 - Сортировка стран" Click="Task4_Click"/>
                <Separator/>
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>
        </Menu>

        <!-- Дополнительный параметр для задания 1 и 4 -->
        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" Padding="10" Margin="0,0,0,10" 
                Visibility="{Binding AdditionalParamVisible, ElementName=MainWindow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="AdditionalParamLabel" Text="Дополнительный параметр:" 
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="AdditionalParamTextBox" Grid.Column="1" Height="30"/>
            </Grid>
        </Border>

        <!-- Область ввода данных -->
        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Входные данные:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="InputTextBox" Grid.Row="1" Height="100" TextWrapping="Wrap" 
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                    <Button x:Name="ActionButton" Content="Выполнить" Click="ExecuteButton_Click" 
                            Width="100" Height="30" Margin="5"/>
                    <Button Content="Очистить" Click="ClearButton_Click" 
                            Width="100" Height="30" Margin="5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Результат -->
        <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="1" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Результат:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="ResultTextBox" Grid.Row="1" TextWrapping="Wrap" 
                         IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>
    </Grid>
</Window>
